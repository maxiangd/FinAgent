# K线历史根数。修改后重启后端生效。
KLINE_DAILY_LIMIT=520
KLINE_WEEKLY_LIMIT=260
KLINE_MONTHLY_LIMIT=120

# ---------- 大模型提供商 ----------
# 只有填了 API Key 的提供商才会出现在前端下拉框里。
# 未指定 LLM_DEFAULT_PROVIDER 时，按 zhipu → deepseek → qwen 的顺序取第一个已配置的。
LLM_DEFAULT_PROVIDER=zhipu
LLM_TIMEOUT_SECONDS=90
# 429/5xx 自动重试次数（免费模型高峰期常触发限流）
LLM_MAX_ATTEMPTS=3

# 智谱开放平台：https://open.bigmodel.cn
# 注意要用「模型标准 API」的 Key，Coding Plan 套餐的 Key 不通用。
# glm-4.7-flash 更新但高峰期常返回 429；glm-4-flash-250414 也是免费且更稳定。
LLM_ZHIPU_API_KEY=
LLM_ZHIPU_MODEL=glm-4-flash-250414

# DeepSeek：https://platform.deepseek.com
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat

# 通义千问（阿里云百炼 OpenAI 兼容模式）：https://bailian.console.aliyun.com
LLM_QWEN_API_KEY=
LLM_QWEN_MODEL=qwen-plus

# 需要换网关或私有部署时再覆盖地址，一般不用填。
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 按 Agent 分配模型（可选） ----------
# 不配置时所有 Agent 跟随任务里选择的提供商；前端「角色模型」面板可按任务覆盖。
# 优先级：任务内按角色选择 > 角色环境变量 > 阶段环境变量 > 任务的提供商。
# 阶段默认值：
# LLM_PROVIDER_ANALYST=zhipu
# LLM_PROVIDER_DEBATE=deepseek
# LLM_PROVIDER_TRADER=deepseek
# LLM_PROVIDER_RISK=deepseek
# LLM_PROVIDER_PM=deepseek
# 角色默认值（优先级高于阶段）：
# LLM_PROVIDER_MARKET_ANALYST=zhipu
# LLM_PROVIDER_FUNDAMENTAL_ANALYST=zhipu
# LLM_PROVIDER_NEWS_SENTIMENT_ANALYST=zhipu
# LLM_PROVIDER_BULL_RESEARCHER=deepseek
# LLM_PROVIDER_BEAR_RESEARCHER=deepseek
# LLM_PROVIDER_TRADER=deepseek
# LLM_PROVIDER_AGGRESSIVE_RISK=deepseek
# LLM_PROVIDER_NEUTRAL_RISK=deepseek
# LLM_PROVIDER_CONSERVATIVE_RISK=deepseek
# LLM_PROVIDER_PORTFOLIO_MANAGER=deepseek

# ---------- 缓存 ----------
# memory：进程内缓存（默认，不需要外部服务）
# redis ：多 worker、重启后仍需保留缓存时使用；连不上会自动回退到 memory
CACHE_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 任务持久化（可选）----------
# 默认连接本机 MongoDB；连不上时任务只保存在进程内
# 需要认证时写成 mongodb://user:password@127.0.0.1:27017/?authSource=admin
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=finagent
